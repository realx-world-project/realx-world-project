generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum ListingType {
  SALE
  SHORT_TERM
  MONTHLY
  ANNUAL
  LONG_TERM
}

enum ListingCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum ReportStatus {
  PENDING
  REVIEWED
}

enum ExportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  name         String?
  phone        String?
  role         UserRole    @default(BUYER)
  isVerified         Boolean     @default(false)
  emailVerifyToken   String?     @unique
  emailVerifyExpiry  DateTime?
  isActive           Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  listings     Listing[]
  savedListings SavedListing[]
  reports      Report[]
  auditLogs    AuditLog[]
  exports      Export[]
  professional Professional?
  materialVendor MaterialVendor?
  kycVerification KycVerification?
  kycStatus       KycStatus @default(NOT_SUBMITTED)
  payments        Payment[]
  escrowsAsBuyer  Escrow[]  @relation("EscrowBuyer")
  escrowsAsSeller Escrow[]  @relation("EscrowSeller")
  enquiries       Enquiry[]
  enquiryMessages EnquiryMessage[]
  upgradeRequest  RoleUpgradeRequest?

  @@map("users")
}

model Listing {
  id          String          @id @default(cuid())
  title       String
  description String
  price       Float
  type        ListingType
  leaseDuration String?
  category    ListingCategory
  status      ListingStatus   @default(PENDING)
  userId      String
  locationId  String
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  location    Location        @relation(fields: [locationId], references: [id])
  images      ListingImage[]
  savedBy     SavedListing[]
  reports     Report[]
  payments    Payment[]
  escrows     Escrow[]
  enquiries   Enquiry[]

  @@map("listings")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  publicId  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])

  @@map("listing_images")
}

model Location {
  id      String   @id @default(cuid())
  state   String
  city    String
  area    String
  address String
  lat     Float?
  lng     Float?

  listings Listing[]

  @@map("locations")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@map("saved_listings")
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  listingId String
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id])
  listing   Listing      @relation(fields: [listingId], references: [id])

  @@map("reports")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Export {
  id          String       @id @default(cuid())
  userId      String
  type        String
  status      ExportStatus @default(PENDING)
  fileUrl     String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user        User         @relation(fields: [userId], references: [id])

  @@map("exports")
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

enum KycIdType {
  NIN
  BVN
  DRIVERS_LICENSE
  PASSPORT
}

model KycVerification {
  id              String    @id @default(cuid())
  userId          String    @unique
  idType          KycIdType
  idNumber        String
  firstName       String
  lastName        String
  dateOfBirth     String
  status          KycStatus @default(PENDING)
  youverifyRef    String?
  failureReason   String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("kyc_verifications")
}

enum ProfessionalCategory {
  SURVEYOR
  ARCHITECT
  ENGINEER
  CONTRACTOR
  LAWYER
  VALUER
  PLANNER
  LANDSCAPER
  PROJECT_MANAGER
  PROPERTY_MANAGER
  OTHER
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Professional {
  id           String               @id @default(cuid())
  userId       String               @unique
  category     ProfessionalCategory
  bio          String
  company      String?
  experience   Int
  location     String
  state        String
  phone        String
  website      String?
  status       ProfessionalStatus   @default(PENDING)
  isVerified   Boolean              @default(false)
  credentials  ProfessionalCredential[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("professionals")
}

model ProfessionalCredential {
  id             String       @id @default(cuid())
  professionalId String
  name           String
  fileUrl        String
  publicId       String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  @@map("professional_credentials")
}

enum MaterialCategory {
  CEMENT
  STEEL_RODS
  SAND
  GRANITE
  BLOCKS
  TIMBER
  ROOFING
  TILES
  PAINT
  PLUMBING
  ELECTRICAL
  DOORS_WINDOWS
  FINISHING
  HEAVY_EQUIPMENT
  OTHER
}

enum MaterialListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model MaterialVendor {
  id          String    @id @default(cuid())
  userId      String    @unique
  businessName String
  description String
  phone       String
  whatsapp    String?
  email       String?
  address     String
  state       String
  isVerified  Boolean   @default(false)
  status      MaterialListingStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings    MaterialListing[]
  @@map("material_vendors")
}

model MaterialListing {
  id          String           @id @default(cuid())
  vendorId    String
  title       String
  description String
  category    MaterialCategory
  price       Float
  unit        String
  minOrder    Int              @default(1)
  state       String
  status      MaterialListingStatus @default(PENDING)
  images      MaterialImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  vendor      MaterialVendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@map("material_listings")
}

model MaterialImage {
  id        String          @id @default(cuid())
  listingId String
  url       String
  publicId  String
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  listing   MaterialListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@map("material_images")
}

enum PaymentType {
  LISTING_FEE
  ENQUIRY_FEE
  ESCROW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EscrowStatus {
  HOLDING
  RELEASED
  REFUNDED
  DISPUTED
}

model PlatformSettings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
  @@map("platform_settings")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  type            PaymentType
  amount          Float
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paystackRef     String?       @unique
  paystackData    Json?
  listingId       String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  listing         Listing?      @relation(fields: [listingId], references: [id])
  escrow          Escrow?
  enquiry         Enquiry?
  @@map("payments")
}

model Escrow {
  id              String       @id @default(cuid())
  paymentId       String       @unique
  buyerId         String
  sellerId        String
  listingId       String
  amount          Float
  commission      Float
  sellerAmount    Float
  status          EscrowStatus @default(HOLDING)
  releasedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payment         Payment      @relation(fields: [paymentId], references: [id])
  buyer           User         @relation("EscrowBuyer", fields: [buyerId], references: [id])
  seller          User         @relation("EscrowSeller", fields: [sellerId], references: [id])
  listing         Listing      @relation(fields: [listingId], references: [id])
  @@map("escrows")
}

model Enquiry {
  id              String        @id @default(cuid())
  buyerId         String
  listingId       String
  paymentId       String?       @unique
  isPaid          Boolean       @default(false)
  message         String?
  isReadBySeller  Boolean       @default(false)
  isReadByBuyer   Boolean       @default(false)
  sellerReply     String?
  repliedAt       DateTime?
  createdAt       DateTime      @default(now())
  buyer           User          @relation(fields: [buyerId], references: [id])
  listing         Listing       @relation(fields: [listingId], references: [id])
  payment         Payment?      @relation(fields: [paymentId], references: [id])
  messages        EnquiryMessage[]
  @@map("enquiries")
}

model EnquiryMessage {
  id          String   @id @default(cuid())
  enquiryId   String
  senderId    String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id])
  @@map("enquiry_messages")
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoleUpgradeRequest {
  id          String               @id @default(cuid())
  userId      String               @unique
  fromRole    UserRole
  toRole      UserRole
  reason      String
  status      UpgradeRequestStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("role_upgrade_requests")
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}