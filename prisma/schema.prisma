generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum ListingType {
  SALE
  RENT
}

enum ListingCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum ReportStatus {
  PENDING
  REVIEWED
}

enum ExportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  name         String?
  phone        String?
  role         UserRole    @default(BUYER)
  isVerified         Boolean     @default(false)
  emailVerifyToken   String?     @unique
  emailVerifyExpiry  DateTime?
  isActive           Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  listings     Listing[]
  savedListings SavedListing[]
  reports      Report[]
  auditLogs    AuditLog[]
  exports      Export[]
  professional Professional?
  materialVendor MaterialVendor?

  @@map("users")
}

model Listing {
  id          String          @id @default(cuid())
  title       String
  description String
  price       Float
  type        ListingType
  category    ListingCategory
  status      ListingStatus   @default(PENDING)
  userId      String
  locationId  String
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  location    Location        @relation(fields: [locationId], references: [id])
  images      ListingImage[]
  savedBy     SavedListing[]
  reports     Report[]

  @@map("listings")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  publicId  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])

  @@map("listing_images")
}

model Location {
  id      String   @id @default(cuid())
  state   String
  city    String
  area    String
  address String
  lat     Float?
  lng     Float?

  listings Listing[]

  @@map("locations")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@map("saved_listings")
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  listingId String
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id])
  listing   Listing      @relation(fields: [listingId], references: [id])

  @@map("reports")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Export {
  id          String       @id @default(cuid())
  userId      String
  type        String
  status      ExportStatus @default(PENDING)
  fileUrl     String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user        User         @relation(fields: [userId], references: [id])

  @@map("exports")
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum ProfessionalCategory {
  SURVEYOR
  ARCHITECT
  ENGINEER
  CONTRACTOR
  LAWYER
  VALUER
  PLANNER
  LANDSCAPER
  PROJECT_MANAGER
  PROPERTY_MANAGER
  OTHER
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Professional {
  id           String               @id @default(cuid())
  userId       String               @unique
  category     ProfessionalCategory
  bio          String
  company      String?
  experience   Int
  location     String
  state        String
  phone        String
  website      String?
  status       ProfessionalStatus   @default(PENDING)
  isVerified   Boolean              @default(false)
  credentials  ProfessionalCredential[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("professionals")
}

model ProfessionalCredential {
  id             String       @id @default(cuid())
  professionalId String
  name           String
  fileUrl        String
  publicId       String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  @@map("professional_credentials")
}

enum MaterialCategory {
  CEMENT
  STEEL_RODS
  SAND
  GRANITE
  BLOCKS
  TIMBER
  ROOFING
  TILES
  PAINT
  PLUMBING
  ELECTRICAL
  DOORS_WINDOWS
  FINISHING
  HEAVY_EQUIPMENT
  OTHER
}

enum MaterialListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model MaterialVendor {
  id          String    @id @default(cuid())
  userId      String    @unique
  businessName String
  description String
  phone       String
  whatsapp    String?
  email       String?
  address     String
  state       String
  isVerified  Boolean   @default(false)
  status      MaterialListingStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings    MaterialListing[]
  @@map("material_vendors")
}

model MaterialListing {
  id          String           @id @default(cuid())
  vendorId    String
  title       String
  description String
  category    MaterialCategory
  price       Float
  unit        String
  minOrder    Int              @default(1)
  state       String
  status      MaterialListingStatus @default(PENDING)
  images      MaterialImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  vendor      MaterialVendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@map("material_listings")
}

model MaterialImage {
  id        String          @id @default(cuid())
  listingId String
  url       String
  publicId  String
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  listing   MaterialListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@map("material_images")
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}